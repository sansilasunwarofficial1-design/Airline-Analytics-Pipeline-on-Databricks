{
  "datasets": [
    {
      "name": "00107b0e",
      "displayName": "State Airport Summary",
      "queryLines": [
        "SELECT\n",
        "  STATE AS state,\n",
        "  COUNT(*) AS total_airports,\n",
        "  COUNT(DISTINCT CITY) AS total_cities\n",
        "FROM\n",
        "  workspace.bronze.gold_dim_airports\n",
        "GROUP BY\n",
        "  STATE\n",
        "ORDER BY\n",
        "  total_airports DESC\n",
        "LIMIT 10"
      ],
      "catalog": "workspace",
      "schema": "gold"
    },
    {
      "name": "state_summary",
      "displayName": "Top 10 States by Airports",
      "queryLines": [
        "SELECT\n",
        "  STATE AS state,\n",
        "  COUNT(*) AS total_airports,\n",
        "  COUNT(DISTINCT CITY) AS total_cities\n",
        "FROM\n",
        "  workspace.bronze.gold_dim_airports\n",
        "GROUP BY\n",
        "  STATE\n",
        "ORDER BY\n",
        "  total_airports DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "e24a96e9",
      "displayName": "State Airport Summary",
      "queryLines": [
        "SELECT\r\n",
        "  STATE AS state,\r\n",
        "  COUNT(*) AS total_airports,\r\n",
        "  COUNT(DISTINCT CITY) AS total_cities\r\n",
        "FROM\r\n",
        "  workspace.bronze.gold_dim_airports\r\n",
        "GROUP BY\r\n",
        "  STATE\r\n",
        "ORDER BY\r\n",
        "  total_airports DESC"
      ],
      "catalog": "workspace",
      "schema": "gold"
    },
    {
      "name": "a2a1e3f4",
      "displayName": "Airport Locations",
      "queryLines": [
        "SELECT\r\n",
        "  airport_name,\r\n",
        "  latitude,\r\n",
        "  longitude\r\n",
        "FROM\r\n",
        "  workspace.bronze.gold_dim_airports\r\n",
        "WHERE\r\n",
        "  latitude IS NOT NULL\r\n",
        "  AND longitude IS NOT NULL"
      ]
    },
    {
      "name": "72d7cabf",
      "displayName": "California Airport Details Extract",
      "queryLines": [
        "-- Display airports in California for dashboard visualization as a table graph\r\n",
        "SELECT airport_code, airport_name, CITY, STATE, COUNTRY, latitude, longitude\r\n",
        "FROM workspace.bronze.gold_dim_airports\r\n",
        "WHERE STATE = 'CA'\r\n",
        "-- To visualize as a table graph, use Databricks' built-in visualization options after running this query"
      ]
    }
